name:          toxav
synopsis:      Tox audio and video calls in Haskell
version:       0.0.1
cabal-version: >=1.10
license:       GPL-3
license-file:  LICENSE
build-type:    Simple
author:        iphy
maintainer:    iphy
copyright:     Copyright (c) 2026 The TokTok Team
homepage:      https://toktok.ltd
category:      Network
description:   Tox audio and video calls, over any Tox implementation.
extra-source-files:
  cbits/audio.h
  cbits/mediacodec.h
  cbits/video.h

source-repository head
  type:     git
  location: https://github.com/TokTok/hs-toxav

library
  default-language: Haskell2010
  hs-source-dirs:   src
  ghc-options:      -Wall
  c-sources:        cbits/audio.c
  include-dirs:     cbits
  pkgconfig-depends: opus
  exposed-modules:
    Tox.AV
    Tox.AV.Assembler
    Tox.AV.Bandwidth
    Tox.AV.Codec
    Tox.AV.Codec.Audio
    Tox.AV.Codec.Types
    Tox.AV.Codec.Video
    Tox.AV.JitterBuffer
    Tox.AV.MSI
    Tox.AV.Playout
    Tox.AV.RTP
    Tox.AV.Session

  build-depends:
      base        <5
    , binary
    , bytestring
    , containers
    , random
    , vector

  -- Browsers have their own video codecs.
  if arch(wasm32)
    hs-source-dirs: browser/src
    build-depends:  ghc-experimental

  else
    hs-source-dirs:    native
    c-sources:         cbits/video.c
    pkgconfig-depends: libavcodec, libavutil

    -- The device's own H.264 encoder.
    if os(android)
      c-sources:       cbits/mediacodec.c
      cpp-options:     -DHSTOXAV_MEDIACODEC
      extra-libraries: mediandk

-- The page in browser/ runs this: a call between two ToxAVs in one page.
executable toxav-browser
  default-language: Haskell2010
  hs-source-dirs:   browser
  main-is:          Main.hs
  ghc-options:
    -Wall -no-hs-main -optl-mexec-model=reactor
    -optl-Wl,--export=hs_init,--export=start

  if !arch(wasm32)
    buildable: False

  build-depends:
      base              <5
    , bytestring
    , ghc-experimental
    , toxav
    , vector

test-suite testsuite
  default-language: Haskell2010
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  ghc-options:      -Wall
  main-is:          testsuite.hs
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    Tox.AV.AssemblerSpec
    Tox.AV.BandwidthSpec
    Tox.AV.CodecSpec
    Tox.AV.JitterBufferSpec
    Tox.AV.MSISpec
    Tox.AV.PlayoutSpec
    Tox.AV.RTPSpec
    Tox.AV.SessionSpec
    Tox.AVSpec

  build-depends:
      base        <5
    , bytestring
    , containers
    , hspec
    , QuickCheck
    , toxav
    , vector
